# ============================================================================
# NidhiSetu environment variables
# Copy to backend/.env (or export in your shell) and fill in as needed.
# Nothing here is required to run the platform in demo mode.
# ============================================================================

# --- App ---
ENVIRONMENT=development
# DEMO_MODE=true keeps the platform fully demonstrable without external
# services: deterministic rules + EMI always work; Mongo, Groq, Pinecone and
# Google OAuth degrade to clearly-labelled demo fallbacks.
DEMO_MODE=true
CORS_ORIGINS=http://localhost:3000

# --- AI (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- RAG (Pinecone) ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=nidhisetu-schemes

# --- Database (MongoDB) ---
# Leave empty to use the in-memory demo store.
MONGODB_URI=

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=1440
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000